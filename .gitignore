# === Test Output ===
# gdUnit4 writes reports/ and Unity's -testResults writes test-results/, both at
# the project root. Anchored so a reports/ folder elsewhere stays tracked.
/reports/
/test-results/

# AI asset pipeline: generator sidecar files (job ids, raw API responses with
# expiring signed URLs). Raw meshes and responses live under out/, which is
# already ignored above; images worth keeping go in evidence/.
*.job.json
*.resp.json
