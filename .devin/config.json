      "Read(**)",
      "Exec(bash .claude/scripts/)",
      "Exec(bash .claude/hooks/)",
      "Exec(bash .devin/hooks/)",
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(git show)",
      "Exec(git branch)",
      "Exec(git tag)",
      "Exec(git rev-parse)",
      "Exec(git add)",
      "Exec(git rm)",
      "Exec(git restore)",
      "Exec(git commit -m)",
      "Exec(git init)",
      "Exec(jq)",
      "Exec(python3)",
      "Exec(node)",
      "Exec(npx)",
      "Exec(npm run)",
      "Exec(npm test)",
      "Exec(npm ci)",
      "Exec(npm install --save-exact)",
      "Exec(ls)",
      "Exec(stat)",
      "Exec(file)",
      "Exec(wc)",
      "Exec(du)",
      "Exec(od)",
      "Exec(find)",
      "Exec(grep)",
      "Exec(rg)",
      "Exec(fd)",
      "Exec(cat)",
      "Exec(head)",
      "Exec(tail)",
      "Exec(mkdir)",
      "Exec(echo)",
      "Exec(printf)",
      "Exec(printenv)",
      "Exec(date)",
      "Exec(basename)",
      "Exec(dirname)",
      "Exec(which)",
      "Exec(test)",
      "Exec(sort)",
      "Exec(uniq)",
      "Exec(awk)",
      "Exec(sed)",
      "Exec(tr)",
      "Exec(cut)",
      "Exec(touch)",
      "Exec(cp)",
      "Exec(mv)",
      "Exec(godot)"
    ],
    "deny": [
      "Exec(rm -rf)",
      "Exec(rm -fr)",
      "Exec(rm -Rf)",
      "Exec(rm -fR)",
      "Exec(rm -r -f)",
      "Exec(rm -f -r)",
      "Exec(rm -R -f)",
      "Exec(rm -f -R)",
      "Exec(rm --recursive)",
      "Exec(rm --force)",
      "Exec(git push --force)",
      "Exec(git push -f)",
      "Exec(git push --force-with-lease)",
      "Exec(git reset --hard)",
      "Exec(git clean -f)",
      "Exec(git clean -d)",
      "Exec(git clean -x)",
      "Exec(git clean -q)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/.git/**)"
    ]
  }
}
